# MegaX — copy to .env and adjust

# Tipsport API
MEGAX_TIPSPORT_BASE_URL=https://www.tipsport.cz
MEGAX_TIPSPORT_COMPETITION_ID=120
# MEGAX_TIPSPORT_STATE_FILE=state/tipsport_scraper_state.json

# Round limits
MEGAX_MAX_MATCHES_PER_ROUND=10

# Results polling (--watch mode)
MEGAX_RESULTS_POLL_INTERVAL_SEC=60

# GUI (default port 18555; auto-refresh je v prohlížeči, localStorage)
MEGAX_GUI_HOST=0.0.0.0
MEGAX_GUI_PORT=18555

# GPP utility (later modules)
MEGAX_FIELD_SIZE=50000
# MEGAX_ALPHA=

# Late swap (GUI recommendations)
MEGAX_SWAP_DELTA_SMALL=3
MEGAX_SWAP_DELTA_LARGE=8
MEGAX_SWAP_LEADER_CHALK=0.85
MEGAX_SWAP_CHASE_ALPHA_BOOST=0.3
MEGAX_SWAP_PROTECT_EV_RATIO=0.95
MEGAX_SWAP_CHASE_EV_RATIO=0.85
